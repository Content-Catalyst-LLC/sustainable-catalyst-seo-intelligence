{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Content-Catalyst-LLC/sustainable-catalyst-seo-intelligence/contracts/seo.url-observation.v1.schema.json",
  "title": "Sustainable Catalyst URL observation (v1)",
  "description": "A single observed fact, not a Google ranking judgment. Source timestamps may be unknown when upstream lacks time zone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "source_kind", "source_method", "source_artifact_sha256", "imported_at_utc", "source_observed_at_raw", "observed_at_utc", "original_url", "comparison_key", "property_scope", "result_state", "http_status", "redirect_target_url", "content_type_code", "declared_canonical", "robots_index_raw", "robots_indexing_raw", "robots_denied_raw", "sitemap_membership", "page_title", "page_description", "page_h1", "review_status", "gsc_indexing_state"],
  "properties": {
    "schema_version": {"const": "seo.url-observation.v1"},
    "observation_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_kind": {"type": "string", "enum": ["gsc_export", "gsc_api", "siteone", "http_probe", "wordpress_read", "human_review"]},
    "source_method": {"type": "string", "minLength": 1},
    "source_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "imported_at_utc": {"type": "string", "format": "date-time"},
    "source_observed_at_raw": {"type": ["string", "null"]},
    "observed_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "original_url": {"type": "string", "maxLength": 4096},
    "comparison_key": {"type": "string", "maxLength": 4096},
    "property_scope": {"type": "string", "format": "uri"},
    "result_state": {"type": "string", "enum": ["observed_http", "unknown_http", "gsc_indexed", "gsc_excluded", "editorial_review"]},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "redirect_target_url": {"type": ["string", "null"]},
    "content_type_code": {"type": ["integer", "null"]},
    "declared_canonical": {"type": ["string", "null"]},
    "robots_index_raw": {"type": ["string", "integer", "boolean", "null"]},
    "robots_indexing_raw": {"type": ["string", "null"]},
    "robots_denied_raw": {"type": ["string", "boolean", "null"]},
    "sitemap_membership": {"type": ["boolean", "null"]},
    "page_title": {"type": ["string", "null"]},
    "page_description": {"type": ["string", "null"]},
    "page_h1": {"type": ["string", "null"]},
    "review_status": {"type": "string", "enum": ["not_reviewed", "needs_review", "reviewed", "rejected"]},
    "gsc_indexing_state": {"type": ["string", "null"]}
  }
}